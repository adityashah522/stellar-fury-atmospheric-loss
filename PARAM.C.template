float			TypeBcTop

#INNERBOUNDARY
ionosphere		TypeBcInner

#SCHEME
1			nOrder
Rusanov			TypeFlux
minmod			TypeLimiter

#SAVELOGFILE
T			DoSaveLogfile
RAW			StringLogfile
1			DnSaveLogfile
-1.			DtSaveLogfile

#SAVEPLOT
2                       nPlotFiles
y=0 MHD idl             StringPlot
100                       DnSavePlot
-1.			DtSavePlot
-1.			Dx
z=0 MHD idl             StringPlot
100                       DnSavePlot
-1.			DtSavePlot
-1.			Dx

