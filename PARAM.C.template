1			nRootBlockY
1			nRootBlockZ
-224.                   xMin
 +32.                   xMax
 -64.                   yMin
 +64.                   yMax
 -64.                   zMin
 +64.                   zMax

#GRIDRESOLUTION
1/8                     Resolution
sphere0                 NameArea
 5.25                   rSphere

#GRIDRESOLUTION
1.0                     Resolution
sphere0                 NameArea
17.5                    rSphere

#GRIDRESOLUTION
2.0                     Resolution
initial

#AMR
100			DnRefine
F			DoAutoRefine

#BODY
T			UseBody
2.5			rBody      [rEarth]
3.5			rCurrents  [rEarth]
28.0			BodyRhoDim [amu/cc]
25000.0			BodyTDim   [K]

#SOLARWIND
{{SW_RHO}}                     SwRhoDim [amu/cc]
100000.0                SwTDim   [K]
  {{SW_UX}}                SwUxDim  [km/s]
     0.0                SwUyDim  [km/s]
     0.0                SwUzDim  [km/s]
     0.0               SwBxDim  [nT]
     0.0                SwByDim  [nT]
    {{SW_BZ}}                SwBzDim  [nT]

#OUTERBOUNDARY
outflow			TypeBcEast
inflow			TypeBcWest
float			TypeBcSouth
float			TypeBcNorth
