#DESCRIPTION
Param/PARAM.in: Part C - Planetary Interaction & Atmospheric Loss (GM+IE+UA)
#PLANET
MARS


#COMPONENTMAP
GM 0 1 1
UA 2 3 1

#TIMEACCURATE
T			IsTimeAccurate

#STARTTIME
2014			iYear
09			iMonth
10			iDay
14			Hour
0			Minute
0			Second
0.0			FracSecond

#SAVERESTART
T			DoSaveRestart
100			DnSaveRestart
3600.0			DtSaveRestart

#UPDATEB0
0.5			DtUpdateB0

#COUPLEORDER
1			nCouple
UA GM			NameSourceTarget

#BEGIN_COMP GM ---------------------------------------------------------------
#GRID
1			nRootBlock1
1			nRootBlock2
1			nRootBlock3
-32.0			xMin
 32.0			xMax
-32.0			yMin
 32.0			yMax
-32.0			zMin
 32.0			zMax

#GRIDBLOCKALL
2000			MaxBlock

#COORDSYSTEM
GSM			TypeCoordSystem

#MAGNETOSPHERE
T			UseBody
2.5			rBody
3.5			rCurrents
8.0			BodyNDim[H+]
8.0			BodyNDim[O+]
25000.0			BodyTDim

#PLASMA
1.0			MassSpecies[H+]
16.0			MassSpecies[O+]
1.0			ChargeSpecies[H+]
1.0			ChargeSpecies[O+]
0.5			ElectronTemperatureRatio

#GRIDRESOLUTION
1.0			Resolution
initial			StringShape

#INNERBOUNDARY
fixed		TypeBcBody

#OUTERBOUNDARY
float			TypeBc1
float			TypeBc2
float			TypeBc3
float			TypeBc4
float			TypeBc5
float			TypeBc6

#SOLARWINDFILE
T			UseSolarWindFile
solarwind.dat		NameSolarWindFile

#SCHEME
2			nOrder
Linde			TypeFlux
mc3			TypeLimiter
1.2			LimiterBeta

#MINIMUMPRESSURE
1E-14			pMinDim

#TIMESTEPPING
2			nStage
0.8			CflExpl

#SAVEPLOT
3			nPlotFile
x=0 VAR idl_ascii		StringPlot
10			DnSavePlot
-1.			DtSavePlot
-1.0			DxSavePlot
rho ux uy uz p bx by bz b1x b1y b1z		NameVars
{default}		NamePars
y=0 VAR idl_ascii		StringPlot
10			DnSavePlot
-1.			DtSavePlot
-1.0			DxSavePlot
rho ux uy uz p bx by bz b1x b1y b1z		NameVars
{default}		NamePars
z=0 VAR idl_ascii		StringPlot
10			DnSavePlot
-1.			DtSavePlot
-1.0			DxSavePlot
rho ux uy uz p bx by bz b1x b1y b1z		NameVars
{default}		NamePars

#SAVELOGFILE
T			DoSaveLogfile
VAR			StringLog
10			DnSaveLogfile
-1.0			DtSaveLogfile
dt rho mx my mz p bx by bz status		NameLogVars

#END_COMP GM -----------------------------------------------------------------



#BEGIN_COMP UA ---------------------------------------------------------------
#GRID
2			nBlocksLon
1			nBlocksLat
-90.0			LatStart
90.0			LatEnd
0.0			LonStart
360.0			LonEnd

#DIFFUSION
T
1750.0		Eddy Diffusion Coefficient
0.00010		Total Eddy Diffusion applied at alts below this pressures level
0.00000		No Eddy Diffusion at altitudes above this pressure level

#THERMALDIFFUSION
5.6e-4		Thermal conductivity

#CPUTIMEMAX
86000.0		Maximum amount of cputime to use before stopping the code

#CFL
0.10		percentage of maximum allowable time-step to take

#LIMITER
mc		only limiter available
1.6

#STATISTICALMODELSONLY
F		if you want to run with msis and iri only
1800.0		time step to take if you run with msis and iri

#LOGFILE
1.0		dt for output to a log file

#SAVEPLOTS
7200.0		dt for writing restart files
1		how many output files do you want
3DALL		output style
300.0		dt for output

#ALTITUDE
100.0		minimum altitude to use
600.0		maximum altitude to use
T		use stretched grid

#INITIAL
F		initialize thermosphere using MSIS
F		initialize ionosphere using IRI
140.0		if msis is false, then this is the temperature at the base
300.0		if msis is false, then this is the temperature at the top
150.0		if msis is false, then this is the height of the middle of temp gradient
25.0		if msis is false, then this is the width of the temperature gradient
1.0e18		if msis is false, then this is the N(species1) at the base
1.0e13		if msis is false, then this is the N(species2) at the base
1.0e13		if msis is false, then this is the N(species3) at the base
3.0e16		if msis is false, then this is the N(species4) at the base
1.0e15		if msis is false, then this is the N(species5) at the base
2.0e16		if msis is false, then this is the N(species6) at the base
1.0e12		if msis is false, then this is the N(species7) at the base
1.0e11		if msis is false, then this is the N(species8) at the base

#TIDES
F		UseMSISFlat
T		UseMSISTides
F		UseGSWMTides
F		UseWACCMTides

#GSWMCOMP
F		Diurnal Migrating
F		Diurnal NonMigrating
F		Semidiurnal Migrating
F		Semidiurnal NonMigrating

#APEX
F		Use apex magnetic coordinate system

#NGDC_INDICES
UA/DataIn/indices.txt

#EUV_DATA
F		Use solar flux data
F		Use flux at planet
fismdaily.dat	Filename

#THERMO
T		 UseSolarHeating
T		 UseJouleHeating
T		 UseAuroralHeating
T		 UseNOCooling
T		 UseOCooling
T		 UseConduction
T		 UseTurbulentConduction
T		 UseUpdatedTurbulentConduction
1.0		 EddyScalingFactor

#WAVEDRAG
T               UseStressHeating

#EDDYVELOCITY
F               UseBoquehoAndBlelly
T               UseEddyCorrection

#FORCING
T		UsePressureGradient
T		UseIonDrag
T		UseNeutralDrag
T		UseViscosity
T		UseCoriolis
T		UseGravity

#IONFORCING
F               UseExB
F               UseIonPressureGradient
T               UseIonGravity
F               UseNeutralDrag
F               UseDynamo

#DYNAMO
F
70.0
500
1.0

#CHEMISTRY
T		UseIonChemistry
F		UseIonAdvection
T		UseNeutralChemistry

#STRETCH
65.0		! location of minimum grid spacing
0.0		! Amount of stretch 0 (none) to 1 (lots)
1.0		! More control of stretch ( > 1 stretch less < 1 stretch more)

#GLOW
F		Whether to couple to GLOW
3600.0		How often to run glow

#END_COMP UA -----------------------------------------------------------------




#COUPLE1
UA			NameSource
GM			NameTarget
10			DnCouple
1.0			DtCouple

#STOP
1000			MaxIter
60.0			TimeMax
